        <rdf:type rdf:resource="http://www.semanticweb.org/mihail/ontologies/2025/5/ontologieRaseCai#CalDeTractiune"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/mihail/ontologies/2025/5/ontologieRaseCai#RasaDeCal"/>
