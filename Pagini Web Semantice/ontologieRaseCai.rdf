    <ontologieRaseCai:descriereTemperament rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Independent, sensibil, loial, dar dificil de dresat.</ontologieRaseCai:descriereTemperament>
    <ontologieRaseCai:greutateMedieKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">450</ontologieRaseCai:greutateMedieKg>
