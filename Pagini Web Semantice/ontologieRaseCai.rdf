        <ontologieRaseCai:areUtilizarePrincipala rdf:resource="http://www.semanticweb.org/mihail/ontologies/2025/5/ontologieRaseCai#MuncaAgricola"/>
        <ontologieRaseCai:descriereTemperament>Docil, calm, blând, cunoscut ca un &apos;gigant blând&apos;.</ontologieRaseCai:descriereTemperament>
